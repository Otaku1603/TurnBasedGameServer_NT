# ============================================================
# TurnBasedGame_Server_NT 环境变量示例（用于容器 / CI / 生产）
#
# 本地开发请优先改 src/main/resources/application-local.yml
#   （该文件已被 .gitignore 忽略，Spring Boot 会自动加载 local profile）
#
# 本文件用于「以环境变量注入配置」的场景：
#   - 容器/CI 里 export 这些变量，或使用 --env-file
#   - 所有变量都会被 application.yml 以 ${VAR:default} 方式读取
#
# docker compose 用法：把本文件复制为同目录的 .env 并填入真实值
#   （.env 已被 .gitignore 忽略；compose 会自动加载，或显式 --env-file）
#   docker-compose.yml 里全部口令用 ${VAR:?...} 引用，缺失即拒绝启动（fail-closed）
# ============================================================

# ---------- 应用 ----------
APP_NAME=turn-based-game-server-nt
APP_PORT=8080
APP_PROFILE=local

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=turn_based_game_nt
DB_USER=tbg_nt
DB_PASSWORD=change_me
# docker compose 的 mysql 容器 root 口令（app 不用 root）
MYSQL_ROOT_PASSWORD=change_me_too

# ---------- Redis ----------
# 本机 Redis：D:\Redis-x64-5.0.14.1\redis-server.exe
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Redis 不可用时是否允许降级启动（本地开发用 true，生产用 false）
REDIS_ALLOW_DEGRADE=true

# ---------- Netty 游戏长连接 ----------
NETTY_PORT=9999
NETTY_USE_PROXY_PROTOCOL=false
NETTY_WORKER_THREADS=4
NETTY_MAX_FRAME_LENGTH=65536
NETTY_READER_IDLE_SECONDS=30
NETTY_WRITER_IDLE_SECONDS=0

# ---------- JWT ----------
# 生产务必替换为高强度随机串（>= 48 字符）
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_48_CHARS
JWT_EXPIRE_HOURS=24

# ---------- 后台管理 ----------
ADMIN_SESSION_TIMEOUT_MINUTES=30

# ---------- 可观测 ----------
MANAGEMENT_PORT=8081
