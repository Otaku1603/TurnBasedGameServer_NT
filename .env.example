# ============================================================
# TurnBasedGame_Server_NT 环境变量示例（容器 / CI / 生产）
#
# 本地裸跑（mvn spring-boot:run）请使用 application-local.yml
# （该文件已被 .gitignore 忽略，且已从 Docker 构建上下文排除）。
#
# docker compose 用法：复制本文件为 .env 并填入真实值
#   docker compose --env-file .env up -d --build
# compose 中的关键口令使用 ${VAR:?...} 引用，缺失即拒绝启动（fail-closed）。
#
# 安全红线：
#   - 本文件不得写入真实口令；真实值只存在于目标环境/secret 管理
#   - 仓库中的 nginx/certs 历史证书/私钥视为已泄露，新环境必须重新生成
# ============================================================

# ---------- 应用 ----------
APP_NAME=turn-based-game-server-nt
APP_PORT=8080
# 容器/部署环境使用非 local profile（不加载 application-local.yml、不播种演示账号）
APP_PROFILE=cluster
APP_STRICT_CONFIG=true

# ---------- 节点身份（N 节点编排必须唯一且稳定） ----------
NODE_ID=node-c1

# ---------- MySQL ----------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=turn_based_game_nt
DB_USER=tbg_nt
DB_PASSWORD=change_me
# docker compose 的 mysql 容器 root 口令（app 不用 root）
MYSQL_ROOT_PASSWORD=change_me_too

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_three
REDIS_DB=0
# false = 关键路径 Redis 异常时失败关闭（生产/集群推荐）；true = 仅本地降级
REDIS_ALLOW_DEGRADE=false

# ---------- Netty 游戏长连接 ----------
NETTY_WS_PORT=9510
NETTY_WORKER_THREADS=4
NETTY_MAX_FRAME_LENGTH=65536
NETTY_READER_IDLE_SECONDS=30
NETTY_WRITER_IDLE_SECONDS=0
# 业务执行组有界队列（防 DB/Redis 阻塞 I/O 线程且不无界堆积）
NETTY_BUSINESS_QUEUE_CAPACITY=4096

# ---------- JWT ----------
# 生产务必替换为高强度随机串（>= 32 字节；建议 48+ 字符）
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_48_CHARS
JWT_EXPIRE_HOURS=24

# ---------- 管理员引导（无默认口令） ----------
# 开启后必须提供 >=12 字符的随机口令，否则启动失败
APP_BOOTSTRAP_ADMIN=true
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_ADMIN_PASSWORD

# ---------- 演示数据 ----------
# 部署环境必须 false；参考数据由 Flyway V7 提供，不依赖演示账号
APP_SEED_DEMO=false

# ---------- 后台管理 ----------
# HTTPS 部署保持 true；纯 HTTP 本地调试才允许 false
ADMIN_COOKIE_SECURE=true
ADMIN_SESSION_TIMEOUT_MINUTES=30

# ---------- 可观测 ----------
MANAGEMENT_PORT=8081

# ---------- 构建 ----------
# 可选：Maven central 镜像（容器内构建时写入临时 settings.xml；留空使用默认）
MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/public

# ---------- 集群渲染（tools/render_cluster.py） ----------
NODE_COUNT=3
